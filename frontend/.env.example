# Copy to .env.local for local runs. Never commit real values.
LOAN_API_BASE_URL=http://localhost:8080
APP_BASE_URL=http://localhost:3000
# Auth0 Regular Web Application (Authorization Code + PKCE)
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=      # secret
AUTH0_SECRET=             # secret: 32+ random bytes, e.g. `openssl rand -hex 32`
AUTH0_AUDIENCE=           # Loan API identifier, same as the API's AUTH0_AUDIENCE
AUTH0_ROLES_CLAIM=https://resource-center.campus/roles
APP_ENV_NAME=local      # shown in the footer, e.g. test

;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];resizable=0;" vertex="1" parent="1"><mxGeometry x="980" y="120" width="200" height="180" as="geometry"/></mxCell></object><object id="web" placeholders="1" c4Name="Web Frontend" c4Type="Container" c4Technology="Next.js 16 (BFF)" c4Description="Server-rendered pages; holds the Auth0 session; proxies allow-listed /api/loan/* calls.&lt;br&gt;&lt;i&gt;Security: HttpOnly session cookie, no token in browser; Origin check&lt;/i&gt;" label='&lt;font style="font-size:15px"&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%: %c4Technology%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size:11px" color="#F0F0F0"&gt;%c4Description%&lt;/font&gt;&lt;/div&gt;'><mxCell style="shape=mxgraph.c4.webBrowserContainer2;whiteSpace=wrap;html=1;boundedLbl=1;rounded=0;labelBackgroundColor=none;fillColor=#23A2D9;strokeColor=#118ACD;strokeColor2=#0E7DAD;fontSize=11;fontColor=#ffffff;align=center;metaEdit=1;resizable=0;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="560" y="440" width="240" height="180" as="geometry"/></mxCell></object><object id="api" placeholders="1" c4Name="Loan API" c4Type="Container" c4Technology="Rust, Tokio, Axum" c4Description="Catalogue, reservations, subscriptions, collect/return; applies loan rules.&lt;br&gt;&lt;i&gt;Security: JWT iss/aud/exp + student/staff RBAC; CORS allow-list&lt;/i&gt;" label='&lt;font style="font-size:15px"&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%: %c4Technology%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size:11px" color="#F0F0F0"&gt;%c4Description%&lt;/font&gt;&lt;/div&gt;'><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;metaEdit=1;resizable=0;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="560" y="740" width="240" height="140" as="geometry"/></mxCell></object><object id="mig" placeholders="1" c4Name="Migrations" c4Type="Container" c4Technology="Rust job, manual trigger" c4Description="Applies schema migrations and seed data before each release.&lt;br&gt;&lt;i&gt;Security: schema-owner identity; run before API&lt;/i&gt;" label='&lt;font style="font-size:15px"&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%: %c4Technology%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size:11px" color="#F0F0F0"&gt;%c4Description%&lt;/font&gt;&lt;/div&gt;'><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;metaEdit=1;resizable=0;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="120" y="1000" width="240" height="140" as="geometry"/></mxCell></object><object id="pg" placeholders="1" c4Name="Loan Database" c4Type="Container" c4Technology="Azure PostgreSQL" c4Description="Authoritative loan state plus transactional outbox table.&lt;br&gt;&lt;i&gt;Security: private subnet; Entra identity per process&lt;/i&gt;" label='&lt;font style="font-size:15px"&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%: %c4Technology%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size:11px" color="#F0F0F0"&gt;%c4Description%&lt;/font&gt;&lt;/div&gt;'><mxCell style="shape=cylinder3;size=15;whiteSpace=wrap;html=1;boundedLbl=1;rounded=0;labelBackgroundColor=none;fillColor=#23A2D9;fontSize=11;fontColor=#ffffff;align=center;strokeColor=#0E7DAD;metaEdit=1;resizable=0;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="560" y="990" width="240" height="150" as="geometry"/></mxCell></object><object id="pub" placeholders="1" c4Name="Outbox Publisher" c4Type="Container" c4Technology="Rust job, cron every 1 min" c4Description="Claims committed outbox rows under a lease; publishes each event once per attempt.&lt;br&gt;&lt;i&gt;Security: outbox-only grants; Service Bus sender role&lt;/i&gt;" label='&lt;font style="font-size:15px"&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%: %c4Technology%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size:11px" color="#F0F0F0"&gt;%c4Description%&lt;/font&gt;&lt;/div&gt;'><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;metaEdit=1;resizable=0;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="560" y="1280" width="240" height="140" as="geometry"/></mxCell></object><object id="sb" placeholders="1" c4Name="Notification Queue" c4Type="Container" c4Technology="Azure Service Bus" c4Description="Durable at-least-once hand-off with dead-letter queue.&lt;br&gt;&lt;i&gt;Security: Entra sender / receiver roles&lt;/i&gt;" label='&lt;font style="font-size:15px"&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%: %c4Technology%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size:11px" color="#F0F0F0"&gt;%c4Description%&lt;/font&gt;&lt;/div&gt;'><mxCell style="shape=cylinder3;size=15;direction=south;whiteSpace=wrap;html=1;boundedLbl=1;rounded=0;labelBackgroundColor=none;fillColor=#23A2D9;fontSize=11;fontColor=#ffffff;align=center;strokeColor=#0E7DAD;metaEdit=1;resizable=0;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="960" y="1280" width="280" height="140" as="geometry"/></mxCell></object><object id="worker" placeholders="1" c4Name="Notifications Worker" c4Type="Container" c4Technology="Rust, Tokio" c4Description="Deduplicates by eventId, retries with backoff, sends email (key from Key Vault).&lt;br&gt;&lt;i&gt;Security: no ingress; no PostgreSQL access&lt;/i&gt;" label='&lt;font style="font-size:15px"&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%: %c4Technology%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size:11px" color="#F0F0F0"&gt;%c4Description%&lt;/font&gt;&lt;/div&gt;'><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;metaEdit=1;resizable=0;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="1360" y="1000" width="240" height="140" as="geometry"/></mxCell></object><object id="cosmos" placeholders="1" c4Name="Notification Store" c4Type="Container" c4Technology="Azure Cosmos DB (NoSQL)" c4Description="Delivery jobs and attempts; ETag optimistic concurrency.&lt;br&gt;&lt;i&gt;Security: worker identity only&lt;/i&gt;" label='&lt;font style="font-size:15px"&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%: %c4Technology%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size:11px" color="#F0F0F0"&gt;%c4Description%&lt;/font&gt;&lt;/div&gt;'><mxCell style="shape=cylinder3;size=15;whiteSpace=wrap;html=1;boundedLbl=1;rounded=0;labelBackgroundColor=none;fillColor=#23A2D9;fontSize=11;fontColor=#ffffff;align=center;strokeColor=#0E7DAD;metaEdit=1;resizable=0;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.7